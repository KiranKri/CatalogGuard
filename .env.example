# Copy to .env. Never commit real API keys.

# sqlite+aiosqlite:///./catalogguard.db
# postgresql+asyncpg://catalogguard:catalogguard@localhost:5432/catalogguard
DATABASE_URL=sqlite+aiosqlite:///./catalogguard.db

# Effective threshold = inventory override, else product override, else this default.
# Low stock means quantity < threshold (strict). Threshold 5 alerts at 4 or fewer.
DEFAULT_LOW_STOCK_THRESHOLD=5

# Suppress a new low-stock event for this long after one fires for the same SKU and store.
# A downward crossing inside the window is dropped, not deferred. See README.
LOW_STOCK_COOLDOWN_SECONDS=86400

# RecentInteraction lookback used only to choose email-draft recipients.
EMAIL_LOOKBACK_HOURS=168

# Email handoff worker (`python -m catalogguard.mailer`, or `make handoff`).
# Queued drafts decided per run, oldest first. One run handles one batch and exits.
EMAIL_HANDOFF_BATCH_SIZE=50
# A queued draft older than this many hours is recorded as expired, without recipients.
EMAIL_HANDOFF_MAX_AGE_HOURS=72

# stub (default, no network) or openai (OpenAI-compatible Chat Completions).
LLM_PROVIDER=stub
# SpaceXAI / xAI is the default compatible endpoint. Point this at any
# OpenAI-compatible server, for example https://api.openai.com/v1.
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
# Used when LLM_API_KEY is empty.
# XAI_API_KEY=
LLM_MODEL=grok-4.7
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
# UTC-day cap on listing generations per SKU. 0 disables the cap.
LLM_DAILY_CAP_PER_SKU=24

HANDLER_MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=0.2

# inline: the request drains the outbox before responding (demo and single process).
# async: drain runs as a background task. The outbox row is still durable.
EVENT_DISPATCH=inline
# A claimed outbox row can be leased again after this many seconds if the worker dies.
OUTBOX_CLAIM_TIMEOUT_SECONDS=300
# A live drain renews its batch lease this often. Must be > 0 and < the claim timeout,
# or the API and `python -m catalogguard.drain` refuse to start.
OUTBOX_LEASE_RENEW_SECONDS=60
# A dead-letter redrive commits a claim before running the handler. Another redrive of
# the same letter gets 409 until the claim is this old, then it may take the claim over.
# Must be > 0, or the API and `python -m catalogguard.drain` refuse to start.
REDRIVE_CLAIM_TIMEOUT_SECONDS=300

LOG_LEVEL=INFO
SEED_ON_STARTUP=false

# Optional override. Defaults to ./prompts when that directory exists.
PROMPTS_DIR=

# Skeleton only. See adr/0001-kafka-event-bus.md. Not wired in this process.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=catalogguard.events
